#!/bin/bash
#
# env.site.sh.example
#
# Copy this file to "env.site.sh" (kept out of git — see .gitignore) and
# fill in YOUR module versions, compiler flags and Slurm settings. What
# differs per experiment and per domain (grids, WRF input, output and
# archive paths, and the ini files) lives in experiments/<name>/ instead;
# everything in scripts/ stays generic.
#
# NOTE: ROOT_DIR is NOT set here — submit.sh works it out from its own
# location and passes it to every job. See README.md: "Where the code lives".
#
#----------------------------------------------------------------
#                SLURM JOB SETTINGS                             |
#----------------------------------------------------------------
# Applied to EVERY job (processing, archive, and run_analysis.sh
# itself). submit.sh reads these and passes them to sbatch as
# --qos / --nodes / --ntasks / --hint / --account / --mail-type /
# --mail-user / --chdir, so nothing needs editing in scripts/. Leave a
# value empty ("") to not pass that flag. (If a line is missing from your
# env.site.sh entirely, submit.sh uses the default shown here.)
#
# This only works for jobs submitted through submit.sh — submit the
# first job with "./submit.sh run_analysis.sh ...", not with
# plain sbatch (see README.md §10).
JOB_QOS="nf"                      # queue (ECMWF: nf = fractional/serial)
JOB_NODES="1"                     # nodes per job
JOB_NTASKS="1"                    # tasks per job (the programs are serial)
JOB_HINT="nomultithread"          # one task per physical core
JOB_ACCOUNT=""                    # your ECMWF project account
JOB_MAIL_TYPE="ALL"               # NONE, BEGIN, END, FAIL, ALL, ...
JOB_MAIL_USER=""                  # e.g. "you@example.org"
JOB_CHDIR=""                      # where job logs land, e.g. "$SCRATCH/Analysis"

#----------------------------------------------------------------
#                    PATHS                                      |
#----------------------------------------------------------------
PROG_DIR=${ROOT_DIR}/f90_src
HEADER_DIR=${ROOT_DIR}/header
# (The ini files are in the experiment's folder, experiments/<name>/.)

#----------------------------------------------------------------
#                EXPERIMENT                                     |
#----------------------------------------------------------------
# Which experiment to run: the name of a folder experiments/<name>/. It
# holds everything that differs per experiment and per domain: <name>.sh
# (grids d01, d02, ..., their domain IDs, WRF input, output and archive
# paths) and the experiment's ini files. See experiments/README.md.
#
# Written as ${EXPERIMENT:-...} so it can be overridden for one submission:
#   EXPERIMENT=cordex ./submit.sh run_analysis.sh ...
# submit.sh passes the chosen EXPERIMENT on to every job of that run.
EXPERIMENT="${EXPERIMENT:-fpsurb}"

#----------------------------------------------------------------
#         COPY/ARCHIVE STEP (run_cp_generic.sh)                 |
#----------------------------------------------------------------
# Modules for the archive step — can (and does, at ECMWF) differ from the
# compile/run modules above.
CP_MODULES="prgenv/intel netcdf4 hpcx-openmpi jasper/2.0.14 hdf5/1.12.2 nco/4.9.7 python3"

# Remote (scp) archive host. The output directories and the ECFS/remote
# archive paths are set per grid in experiments/<name>.sh.
REMOTE_HOST="wrf@nimbus.degge.fc.ul.pt"

#----------------------------------------------------------------
#                COMPILER / LIBRARY VERSIONS         |
#----------------------------------------------------------------
source ~/.bash_compile_wrf

intel_v="2023.2"
hdf5_v="1.14.3"
netcdf_v="4.9.2"
hpx_v="2.17"

FC="ifort"
FFLAGS="-traceback -check all"
MOD_NAME="datvar_s"
SUB_NAME="shared_subs_v2"

NC_INC="-I/usr/local/apps/netcdf4-parallel/${netcdf_v}/INTEL/${intel_v}/HPCX/${hpx_v}/include"
NC_LIB="-L/usr/local/apps/netcdf4-parallel/${netcdf_v}/INTEL/${intel_v}/HPCX/${hpx_v}/lib64 -lnetcdff -lnetcdf"
HDF_LIB="-L/usr/local/apps/hdf5-parallel/${hdf5_v}/INTEL/${intel_v}/HPCX/${hpx_v}/lib64 -lhdf5hl_fortran -lhdf5_hl -lhdf5_fortran -lhdf5"
OTHER_LIBS="-lm -lz"

ALL_LIBS="$NC_INC $NC_LIB $HDF_LIB $OTHER_LIBS"

