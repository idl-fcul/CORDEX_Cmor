#!/bin/bash
#
# env.site.sh.example — copy to env.site.sh and fill in (README.md §4).
# Per-experiment settings live in experiments/<name>/ instead.
#----------------------------------------------------------------

#--- Slurm settings, passed to every job by submit.sh ("" = don't pass)
JOB_QOS="nf"                      # queue (ECMWF: nf = fractional/serial)
JOB_NODES="1"                     # nodes per job
JOB_NTASKS="1"                    # tasks per job (the programs are serial)
JOB_HINT="nomultithread"          # one task per physical core
JOB_ACCOUNT=""                    # your ECMWF project account
JOB_MAIL_TYPE="ALL"               # NONE, BEGIN, END, FAIL, ALL, ...
JOB_MAIL_USER=""                  # e.g. "you@example.org"
JOB_CHDIR=""                      # where job logs land, e.g. "$SCRATCH/Analysis"

#--- Paths ------------------------------------------------------
PROG_DIR=${ROOT_DIR}/f90_src
HEADER_DIR=${ROOT_DIR}/header

#--- Experiment: folder name in experiments/ (override: EXPERIMENT=<name> ./submit.sh ...)
EXPERIMENT="${EXPERIMENT:-fpsurb}"

#--- Archive step: modules and remote host ----------------------
CP_MODULES="prgenv/intel netcdf4 hpcx-openmpi jasper/2.0.14 hdf5/1.12.2 nco/4.9.7 python3"

REMOTE_HOST="wrf@nimbus.degge.fc.ul.pt"

#--- Compiler and libraries -------------------------------------
source ~/.bash_compile_wrf

intel_v="2023.2"
hdf5_v="1.14.3"
netcdf_v="4.9.2"
hpx_v="2.17"

FC="ifort"
FFLAGS="-traceback -check all"
MOD_NAME="datvar_s"
SUB_NAME="shared_subs_v2"

NC_INC="-I/usr/local/apps/netcdf4-parallel/${netcdf_v}/INTEL/${intel_v}/HPCX/${hpx_v}/include"
NC_LIB="-L/usr/local/apps/netcdf4-parallel/${netcdf_v}/INTEL/${intel_v}/HPCX/${hpx_v}/lib64 -lnetcdff -lnetcdf"
HDF_LIB="-L/usr/local/apps/hdf5-parallel/${hdf5_v}/INTEL/${intel_v}/HPCX/${hpx_v}/lib64 -lhdf5hl_fortran -lhdf5_hl -lhdf5_fortran -lhdf5"
OTHER_LIBS="-lm -lz"

ALL_LIBS="$NC_INC $NC_LIB $HDF_LIB $OTHER_LIBS"

